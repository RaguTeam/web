{$DOMAIN} {
	encode zstd gzip

	# /metrics отдаёт внутренности приложения и предназначен только для
	# Prometheus, который ходит к back:8000 внутри docker-сети. Снаружи его
	# быть не должно — иначе он публичен, потому что ниже стоит catch-all.
	handle /metrics* {
		respond 404
	}

	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy back:8000
	}
}
