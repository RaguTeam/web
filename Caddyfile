{$DOMAIN} {
	encode zstd gzip

	# /metrics отдаёт внутренности приложения и предназначен только для
	# Prometheus, который ходит к back:8000 внутри docker-сети. Снаружи его
	# быть не должно — иначе он публичен, потому что ниже стоит catch-all.
	handle /metrics* {
		respond 404
	}

	# Без слеша путь не совпал бы с матчером ниже и ушёл в catch-all к бэкенду,
	# который ответил бы 404.
	redir /grafana /grafana/ 301

	# `handle`, а НЕ `handle_path`: последний срезает префикс, а Grafana поднята
	# с GF_SERVER_SERVE_FROM_SUB_PATH=true и ждёт его на месте. Со срезанием она
	# получает "/", решает что должна жить в /grafana/, редиректит туда, Caddy
	# снова срезает — и это бесконечный цикл, ERR_TOO_MANY_REDIRECTS.
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy back:8000
	}
}
