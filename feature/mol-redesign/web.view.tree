$raggu_web_front_base $mol_view

$raggu_web_front_text $mol_view
	dom_name \p
	sub /$mol_view_content
		<= text \

$raggu_web_front_label $raggu_web_front_text

$raggu_web_front_skeleton $mol_view
	attr *
		^
		aria-hidden \true

$raggu_web_front_reveal $mol_view
	delay 0
	style *
		^
		--reveal-delay <= delay_css \0ms
	attr *
		^
		raggu_web_front_reveal_shown <= shown? false

$raggu_web_front_link $mol_view
	dom_name \a
	uri \
	arg *
	hint \
	attr *
		^
		href <= href \
		title <= hint
	event *
		^
		click? <=> click? null
	sub /$mol_view_content

$mol_speck $mol_view
	theme \$mol_theme_accent
	sub /
		<= value null

$mol_button $mol_view
	enabled true
	click? null
	event_click? null
	status? /
	event *
		^
		click? <=> activate? <=> event_activate? null
		dblclick? <=> clicks? null
		keydown? <=> key_press? <=> event_key_press? null
	attr *
		^
		disabled <= disabled false
		role \button
		tabindex <= tab_index 0
		title <= hint_safe <= hint \
	sub /$mol_view_content
		<= title
	Speck $mol_speck
		value <= error \

$raggu_web_front_lib_names $mol_object
	entity_AGE @ \Age
	entity_ANATOMICAL_STRUCTURE @ \Anatomical structure
	entity_ANATOMICAL_SYSTEM @ \Anatomical system
	entity_ANATOMY @ \Anatomy
	entity_ATTRIBUTE @ \Attribute
	entity_AWARD @ \Award
	entity_BEHAVIOR @ \Behavior
	entity_BIOLOGICAL_ENTITY @ \Biological entity
	entity_BIOLOGICAL_PROCESS @ \Biological process
	entity_BIOMATERIAL @ \Biomaterial
	entity_CELL @ \Cell
	entity_CELL_TYPE @ \Cell type
	entity_CITY @ \City
	entity_CLASSIFICATION_SYSTEM @ \Classification system
	entity_CONCEPT @ \Concept
	entity_CONDITION @ \Condition
	entity_COUNTRY @ \Country
	entity_CRIME @ \Crime
	entity_DATE @ \Date
	entity_DESCRIPTION @ \Description
	entity_DISEASE @ \Disease
	entity_DISEASE_OR_DISORDER @ \Disease or disorder
	entity_DISTRICT @ \District
	entity_DOCUMENT @ \Document
	entity_DRUG_OR_CHEMICAL @ \Drug or chemical
	entity_EVENT @ \Event
	entity_FACILITY @ \Facility
	entity_FAMILY @ \Family
	entity_GENE @ \Gene
	entity_GENE_MUTATION @ \Gene mutation
	entity_GENE_OR_PROTEIN @ \Gene or protein
	entity_GENETIC_TEST @ \Genetic test
	entity_GROUP @ \Group
	entity_HORMONE @ \Hormone
	entity_IDEOLOGY @ \Ideology
	entity_LANGUAGE @ \Language
	entity_LAW @ \Law
	entity_LOCATION @ \Location
	entity_MEASUREMENT @ \Measurement
	entity_MEASUREMENT_OR_OUTCOME @ \Measurement or outcome
	entity_MEDICAL_CONDITION @ \Medical condition
	entity_MONEY @ \Money
	entity_NATIONALITY @ \Nationality
	entity_NUMBER @ \Number
	entity_ORDINAL @ \Ordinal
	entity_ORGAN @ \Organ
	entity_ORGANIZATION @ \Organization
	entity_PATHOLOGICAL_ENTITY @ \Pathological entity
	entity_PENALTY @ \Penalty
	entity_PERCENT @ \Percent
	entity_PERSON @ \Person
	entity_PROCEDURE @ \Procedure
	entity_PROCEDURE_OR_INTERVENTION @ \Procedure or intervention
	entity_PROCESS @ \Process
	entity_PRODUCT @ \Product
	entity_PROFESSION @ \Profession
	entity_PROTEIN @ \Protein
	entity_PROTOCOL @ \Protocol
	entity_RELIGION @ \Religion
	entity_SOFTWARE @ \Software
	entity_STATE_OR_PROV @ \State or prov
	entity_SUBTYPE @ \Subtype
	entity_SURGERY @ \Surgery
	entity_SYMPTOM_OR_FINDING @ \Symptom or finding
	entity_SYSTEM @ \System
	entity_TEST @ \Test
	entity_TIME @ \Time
	entity_TREATMENT @ \Treatment
	entity_WEBSITE @ \Website
	entity_WORK_OF_ART @ \Work of art
	relation_AFFECTED_BY @ \Affected by
	relation_AFFECTS @ \Affects
	relation_AGENT @ \Agent
	relation_ALTERNATIVE_TO @ \Alternative to
	relation_APPLICABLE_TO @ \Applicable to
	relation_BASED_ON @ \Based on
	relation_BIOMARKER @ \Biomarker
	relation_CAUSE_OF @ \Cause of
	relation_CELL_TYPE_PRESENT_IN_DISEASE @ \Cell type present in disease
	relation_COMBINED_WITH @ \Combined with
	relation_CONTAINS @ \Contains
	relation_COVERED_BY @ \Covered by
	relation_DIAGNOSED_WITH @ \Diagnosed with
	relation_DOCUMENT_SOURCE @ \Document source
	relation_EXAMPLE_OF @ \Example of
	relation_EXPRESSED_IN @ \Expressed in
	relation_GENE_ASSOCIATION @ \Gene association
	relation_HAS_CAUSE @ \Has cause
	relation_HAS_EFFECT @ \Has effect
	relation_INCIDENCE_INCREASES @ \Incidence increases
	relation_INSTANCE_OF @ \Instance of
	relation_INVOLVES @ \Involves
	relation_INVOLVES_REMOVAL @ \Involves removal
	relation_INVOLVES_TEST @ \Involves test
	relation_LOCATED_IN @ \Located in
	relation_LOCATION @ \Location
	relation_LOCATION_OF_DISEASE @ \Location of disease
	relation_MANAGEMENT_STRATEGY @ \Management strategy
	relation_PART_OF @ \Part of
	relation_PARTICIPANT_IN @ \Participant in
	relation_PRECEDES @ \Precedes
	relation_PRODUCES @ \Produces
	relation_PRODUCT @ \Product
	relation_RELATED_TO @ \Related to
	relation_REMOVES @ \Removes
	relation_REPORTED_TO @ \Reported to
	relation_RISK_FACTOR @ \Risk factor
	relation_RISK_FACTOR_FOR @ \Risk factor for
	relation_SIDE_EFFECT @ \Side effect
	relation_SPREAD_TO @ \Spread to
	relation_STARTS_IN @ \Starts in
	relation_SUBCLASS_OF @ \Subclass of
	relation_SUPERCLASS_OF @ \Superclass of
	relation_SYNONYM @ \Synonym
	relation_TARGET_OF @ \Target of
	relation_TARGETS @ \Targets
	relation_TREATMENT @ \Treatment
	relation_TREATMENT_FOR @ \Treatment for
	relation_TREATS @ \Treats
	relation_TYPE_OF @ \Type of
	relation_USED_FOR @ \Used for
	relation_USED_IN @ \Used in
	relation_USES @ \Uses

$raggu_web_front_scene $mol_view
	viewer $raggu_web_front_viewer
	lights \light
	attr *
		^
		raggu_web_front_scene_interactive <= interactive false
		raggu_web_front_scene_mounted <= mounted false
	sub /
		<= Layer $raggu_web_front_scene_layer

$raggu_web_front_glass $mol_view
	dom_name \span
	attr *
		^
		aria-hidden \true
		raggu_web_front_glass_solid <= solid false

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16

$raggu_web_front_mark $mol_image
	uri <= data_uri \
	title \RAGU

$raggu_web_front_pop $mol_view
	showed? false
	close? null
	align \start
	offset 10
	bubble_width \auto
	attr *
		^
		raggu_web_front_pop_showed <= showed?
	sub /
		<= Trigger $mol_button
			hint <= hint \
			attr *
				^
				aria-label <= hint
				aria-expanded <= showed?
				raggu_web_front_pop_open <= showed?
			click? <=> toggle? null
			sub <= trigger_content /$mol_view_content
		<= Bubble $mol_view
			attr *
				^
				popover \manual
			style *
				^
				width <= bubble_width
			event *
				^
				keydown? <=> bubble_keydown? null
			sub /
				<= Glass $raggu_web_front_glass
					solid true
				<= Content $mol_view
					sub <= bubble_content /$mol_view_content

$mol_svg $mol_view
	dom_name \svg
	dom_name_space \http://www.w3.org/2000/svg
	font_size 16
	font_family \
	style_size *

$mol_svg_root $mol_svg
	dom_name \svg
	attr *
		^
		viewBox <= view_box \0 0 100 100
		preserveAspectRatio <= aspect \xMidYMid

$mol_svg_path $mol_svg
	dom_name \path
	attr *
		^
		d <= geometry \


$raggu_web_front_icon $mol_svg_root
	view_box \0 0 18 18
	attr *
		^
		aria-hidden \true
	sub /
		<= Stroke $mol_svg_path
			geometry <= path \
		<= Fill $mol_svg_path
			geometry <= fill \

