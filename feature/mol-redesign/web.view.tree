$raggu_web_front_home_head $raggu_web_front_reveal
	eyebrow \
	title \
	lede \
	sub /
		<= Eyebrow $raggu_web_front_label
			text <= eyebrow
		<= Title $mol_view
			dom_name \h2
			sub / <= title
		<= Lede $raggu_web_front_text
			text <= lede

$raggu_web_front_home_pipeline $mol_object
	step_1_name @ \Chunk
	step_1_detail @ \Documents are split on sentence boundaries, not on a fixed character count, so an entity never straddles the cut.
	step_1_output @ \text chunks
	step_2_name @ \Extract
	step_2_detail @ \A model reads every chunk and returns typed entities and typed relations, each with a description and a confidence score.
	step_2_output @ \entities · relations
	step_3_name @ \Cluster
	step_3_detail @ \Leiden community detection groups the graph into themes, then each theme is summarised in its own right.
	step_3_output @ \communities · summaries
	step_4_name @ \Answer
	step_4_detail @ \A question walks the neighbourhood, reads the community summaries, or both — and the chunk behind each claim comes back with it.
	step_4_output @ \answer · citations

