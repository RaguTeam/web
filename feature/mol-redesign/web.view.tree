	path \M3 6.2V4.3a1.3 1.3 0 0 1 1.3-1.3H6.2M11.8 3h1.9A1.3 1.3 0 0 1 15 4.3v1.9M15 11.8v1.9a1.3 1.3 0 0 1-1.3 1.3h-1.9M6.2 15H4.3A1.3 1.3 0 0 1 3 13.7v-1.9M7 9a2 2 0 1 0 4 0a2 2 0 1 0 -4 0

$raggu_web_front_icon_caret $raggu_web_front_icon
	view_box \0 0 12 12
	path \M2 4.5 L6 8.5 L10 4.5

$raggu_web_front_chrome_switcher $raggu_web_front_pop
	corpus \
	hint <= pick_label @ \Switch corpus
	bubble_width \min(30rem, calc(100vw - 2rem))
	trigger_content /
		<= Current $mol_view
			dom_name \span
			sub /
				<= Current_label $raggu_web_front_label
					dom_name \span
					text <= corpus_label @ \Corpus
				<= Current_title $mol_view
					dom_name \span
					sub / <= current_title \
		<= Caret $raggu_web_front_icon_caret
	bubble_content /
		<= Heading $mol_view
			sub /
				<= Heading_label $raggu_web_front_label
					text <= corpora_label @ \Corpora
		<= List $mol_view
			sub <= rows /
	Row* $raggu_web_front_link
		arg *
			corpus <= row_id* \
		click? <=> row_click*? null
		attr *
			^
			raggu_web_front_chrome_switcher_row_current <= row_current* false
		sub /
			<= Row_text* $mol_view
				dom_name \span
				sub /
					<= Row_title* $mol_view
						dom_name \span
						sub / <= row_title* \
					<= Row_domain* $mol_view
						dom_name \span
						sub / <= row_domain* \
			<= Row_count* $raggu_web_front_label
				dom_name \span
				text <= row_count* \
	Row_skeleton* $raggu_web_front_skeleton

$raggu_web_front_chrome_toggle $mol_button
	active false
	label \
	Icon $raggu_web_front_icon
	attr *
		^
		aria-pressed <= active
	sub /
		<= Pane $mol_view
			dom_name \span
			attr *
				^
				class \accent-pane
				aria-hidden \true
		<= Icon
		<= label

$raggu_web_front_chrome $mol_view
	dom_name \header
	viewer $raggu_web_front_viewer
	theme_choice? \system
	theme_resolved \light
	attr *
		^
		raggu_web_front_chrome_scrolled <= scrolled false
		raggu_web_front_chrome_corpus <= corpus_page false
	sub /
		<= Row $mol_view
			sub /
				<= Brand $mol_view
					sub /
						<= Brand_glass $raggu_web_front_glass
						<= Home_link $raggu_web_front_link
							arg *
								corpus null
							hint <= home_label @ \Home
							sub /
								<= Mark $raggu_web_front_mark
								<= Wordmark $mol_view
									dom_name \span
									sub /
										<= Word $mol_view
											dom_name \span
											sub / \RAGU
										<= Word_sub $mol_view
											dom_name \span
											sub / \graph rag
						<= Switcher_box $mol_view
							sub /
								<= Switcher_rule $mol_view
									dom_name \span
								<= Switcher $raggu_web_front_chrome_switcher
									corpus <= corpus \
				<= Right $mol_view
					sub <= right /
						<= Tools $raggu_web_front_chrome_tools
							viewer <= viewer
						<= Controls $mol_view
							sub /
								<= Controls_glass $raggu_web_front_glass
								<= Theme_menu $raggu_web_front_chrome_theme
									choice? <=> theme_choice?
									resolved <= theme_resolved
								<= Lang_menu $raggu_web_front_chrome_lang
								<= Controls_rule $mol_view
									dom_name \span
								<= Settings_open $mol_button
									hint <= settings_label @ \Retrieval settings
									attr *
										^
										aria-label <= settings_label
									click? <=> open_settings? null
									sub /
										<= Settings_icon $raggu_web_front_icon_sliders
				<= Centre_box $mol_view
					sub /
						<= Centre $mol_view
							attr *
								^
								raggu_web_front_chrome_centre_kind <= centre_kind \home
							sub /
								<= Centre_glass $raggu_web_front_glass
								<= Pane_home $mol_view
									attr *
										^
										data-active <= home_active \
										inert <= home_inert \
									sub /
										<= Link_pipeline $mol_button
											click? <=> to_pipeline? null
											sub / <= pipeline_label @ \How it works
										<= Link_corpora $mol_button
											click? <=> to_corpora? null
											sub / <= corpora_label @ \Corpora
								<= Pane_corpus $mol_view
									attr *
										^
										data-active <= corpus_active \
										inert <= corpus_inert \
									sub /
										<= Toggle_graph $raggu_web_front_chrome_toggle
											active <= graph_active false
											click? <=> toggle_graph? null
											Icon <= Graph_icon $raggu_web_front_icon_graph
											label <= graph_label @ \Relations
										<= Toggle_chat $raggu_web_front_chrome_toggle
											active <= chat_active false
											click? <=> toggle_chat? null
											Icon <= Chat_icon $raggu_web_front_icon_chat
											label <= chat_label @ \Chat

$raggu_web_front_chrome_menu $raggu_web_front_pop
	align \end
	bubble_width \11rem
	trigger_content /
		<= Trigger_icon $raggu_web_front_icon
	bubble_content /
		<= Heading $raggu_web_front_label
			text <= heading \
		<= Items $mol_view
			sub <= items /

$raggu_web_front_chrome_menu_item $mol_button
	checked false
	attr *
		^
		role \menuitemradio
		aria-checked <= checked
	sub /
		<= Lead $mol_view
			dom_name \span
			sub <= lead /$mol_view_content
		<= Name $mol_view
			dom_name \span
			sub / <= name \
		<= Dot $mol_view
			dom_name \span

$raggu_web_front_chrome_theme $raggu_web_front_chrome_menu
	choice? \system
	resolved \light
	hint <= theme_label @ \Appearance
	heading <= theme_label
	Trigger_icon <= Current_icon $raggu_web_front_icon
	items /
		<= Light $raggu_web_front_chrome_menu_item
			checked <= light_checked false
			click? <=> pick_light? null
			lead / <= Light_icon $raggu_web_front_icon_sun
			name <= light_label @ \Light
		<= Dark $raggu_web_front_chrome_menu_item
			checked <= dark_checked false
			click? <=> pick_dark? null
			lead / <= Dark_icon $raggu_web_front_icon_moon
			name <= dark_label @ \Dark
		<= System $raggu_web_front_chrome_menu_item
			checked <= system_checked false
			click? <=> pick_system? null
			lead / <= System_icon $raggu_web_front_icon_display
			name <= system_label @ \Match system
	Sun_icon $raggu_web_front_icon_sun
	Moon_icon $raggu_web_front_icon_moon
	Display_icon $raggu_web_front_icon_display

$raggu_web_front_chrome_lang $raggu_web_front_chrome_menu
	hint <= lang_label @ \Language
	heading <= lang_label
	Trigger_icon <= Globe_icon $raggu_web_front_icon_globe
	items /
		<= En $raggu_web_front_chrome_menu_item
			checked <= en_checked false
			click? <=> pick_en? null
			lead / \EN
			name \English
		<= Ru $raggu_web_front_chrome_menu_item
			checked <= ru_checked false
			click? <=> pick_ru? null
			lead / \RU
			name \Русский

$raggu_web_front_settings $mol_view
	showed? false
	attr *
		^
		raggu_web_front_settings_showed <= showed?
	event *
		^
		keydown? <=> keydown? null
	sub /
		<= Backdrop $mol_view
			event *
				click? <=> close? null
		<= Popup $mol_view
			attr *
				^
				role \dialog
				aria-modal \true
			sub /
				<= Glass $raggu_web_front_glass
					solid true
				<= Body $mol_view
					sub /
						<= Head $mol_view
							sub /
								<= Head_text $mol_view
									sub /
										<= Title $mol_view
											dom_name \h2
											sub / <= title_label @ \Retrieval settings
										<= Subtitle $raggu_web_front_label
											text <= subtitle_label @ \how the agent looks for an answer
								<= Close_icon $mol_button
									hint <= close_label @ \Close
									attr *
										^
										aria-label <= close_label
									click? <=> close?
									sub /
										<= Close_glyph $raggu_web_front_icon_close
						<= Group $mol_view
							sub /
								<= Group_label $raggu_web_front_label
									text <= group_label @ \Retrieval
								<= Group_hint $raggu_web_front_text
									text <= group_hint @ \graph in the answer · decomposition of complex questions
						<= Rows $mol_view
							sub /
								<= Use_graph $raggu_web_front_settings_toggle
									label <= use_graph_label @ \Graph in search
									hint <= use_graph_hint @ \Off: chunk-vector search only (NaiveSearchEngine). On: chunks plus local graph neighbourhoods (MixSearchEngine).
									checked? <=> use_graph? false
									on_label <= on_label @ \On
									off_label <= off_label @ \Off
								<= Query_plan $raggu_web_front_settings_toggle
									label <= query_plan_label @ \Query planning
									hint <= query_plan_hint @ \Break a complex question into a DAG of simpler sub-questions before retrieving.
									checked? <=> query_plan? false
									on_label <= on_label
									off_label <= off_label
								<= Rerank $raggu_web_front_settings_toggle
									label <= rerank_label @ \Rerank candidates
									hint <= rerank_hint @ \Re-score retrieved passages before they are handed to the model. Noticeably slower.
									checked? <=> rerank? false
									on_label <= on_label
									off_label <= off_label
								<= Top_k $mol_view
									sub /
										<= Top_k_text $mol_view
											sub /
												<= Top_k_label $raggu_web_front_text
													text <= top_k_label @ \Passages retrieved
												<= Top_k_hint $raggu_web_front_text
													text <= top_k_hint @ \How many candidates reach the model. More context, slower answer.
										<= Top_k_field $mol_view
											sub /
												<= Top_k_less $mol_button
													hint <= top_k_less_label @ \Fewer passages
													attr *
														^
														aria-label <= top_k_less_label
													enabled <= top_k_less_enabled true
													click? <=> top_k_less? null
													sub / \−
												<= Top_k_input $mol_view
													dom_name \input
													attr *
														^
														aria-label <= top_k_label
														inputmode \numeric
													field *
														^
														value <= top_k_draft? \8
													event *
														input? <=> top_k_input? null
														change? <=> top_k_commit? null
														blur? <=> top_k_commit?
														keydown? <=> top_k_key? null
												<= Top_k_more $mol_button
													hint <= top_k_more_label @ \More passages
													attr *
														^
														aria-label <= top_k_more_label
													enabled <= top_k_more_enabled true
													click? <=> top_k_more? null
													sub / \+
								<= Limit $mol_view
									sub /
										<= Limit_head $mol_view
											sub /
												<= Limit_label $raggu_web_front_text
													text <= limit_label @ \Entities in the cloud
												<= Limit_value $mol_view
													dom_name \span
													sub / <= limit_value \600
										<= Limit_hint $raggu_web_front_text
											text <= limit_hint @ \The renderer stays smooth well past a thousand points; the network is the limit.
										<= Steps $mol_view
											sub <= steps /
										<= Limit_note $raggu_web_front_text
											text <= api_cap @ \The gateway hands over at most 5000 entities per request, so a larger corpus is always a slice.
						<= Divider $mol_view
						<= Foot $mol_view
							sub /
								<= Reset $mol_button
									click? <=> reset? null
									sub / <= reset_label @ \Restore defaults
								<= Done $mol_button
									click? <=> close?
									sub / <= close_label
	Step* $mol_button
		attr *
			^
			raggu_web_front_settings_step_active <= step_active* false
		click? <=> step_pick*? null
		sub /
			<= Step_pane* $mol_view
				dom_name \span
				attr *
					^
					class <= step_pane_class* \
					aria-hidden \true
			<= step_text* \

$raggu_web_front_settings_toggle $mol_view
	label \
	hint \
	checked? false
