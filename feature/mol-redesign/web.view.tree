	off_label \Off
	sub /
		<= Text $mol_view
			sub /
				<= Label $raggu_web_front_text
					text <= label
				<= Hint $raggu_web_front_text
					text <= hint
		<= Control $mol_view
			sub /
				<= State $raggu_web_front_label
					dom_name \span
					text <= state_text \
				<= Switch $mol_button
					attr *
