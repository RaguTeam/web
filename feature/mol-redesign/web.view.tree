			<= Agent_label* $raggu_web_front_label
				text <= agent_label @ \RAGU
			<= Answer* $mol_view
				sub <= answer* /
			<= Agent_sources* $mol_view
				sub <= agent_sources* /
	Streaming $mol_view
		dom_name \li
		sub /
			<= Streaming_label $raggu_web_front_label
				text <= agent_label
			<= Streaming_answer $mol_view
				sub <= streaming_answer /
	Caret $mol_view
		dom_name \span
		attr *
			^
			aria-hidden \true
	Strong* $mol_view
		dom_name \strong
		sub / <= strong_text* \
	Ref* $mol_button
		hint <= citation_label @ \Show in the graph
		attr *
			^
			class \ref
			data-ref <= ref_id* \
		click? <=> ref_pick*? null
		sub / <= ref_text* \
	Ref_muted* $mol_view
		dom_name \span
		attr *
			^
			class \ref ref--muted
			data-ref <= ref_id*
		sub / <= ref_text*
	Pending $mol_view
		dom_name \li
		sub /
			<= Pending_box $mol_view
				sub /
					<= Pending_head $mol_view
						sub /
							<= Ping $mol_view
								dom_name \span
								sub /
									<= Ping_wave $mol_view
										dom_name \span
									<= Ping_dot $mol_view
										dom_name \span
							<= Thinking $raggu_web_front_text
								text <= thinking_label @ \Retrieving and composing
							<= Elapsed $raggu_web_front_label
								dom_name \span
								text <= elapsed \
					<= Thinking_hint $raggu_web_front_text
						text <= thinking_hint @ \Inference runs on CPU here, so this takes a moment.
					<= Bars $mol_view
						sub /
							<= Bar1 $raggu_web_front_skeleton
							<= Bar2 $raggu_web_front_skeleton
							<= Bar3 $raggu_web_front_skeleton
	Failure $mol_view
		dom_name \li
		sub /
			<= Failure_title $raggu_web_front_text
				text <= failure_text \
			<= Failure_hint $raggu_web_front_text
				text <= failure_hint @ \The API did not answer. It may be waking up — try again in a moment.
	Starter* $mol_view
		dom_name \li
		sub /
			<= Starter_button* $mol_button
				click? <=> starter_send*? null
				sub / <= starter_text* \
	Send $mol_button
		hint <= send_label @ \Send
		attr *
			^
			type \submit
			aria-label <= send_label
		enabled <= send_enabled false
		click? <=> send_click? null
		sub /
			<= Send_icon $raggu_web_front_icon_send
	Stop $mol_button
		hint <= stop_label @ \Stop
		attr *
			^
			aria-label <= stop_label
		click? <=> stop? null
		sub /
			<= Stop_icon $raggu_web_front_icon_stop
	Sources* $raggu_web_front_disclosure
		label <= sources_label @ \Sources
		hint <= sources_hint @ \What the answer read
		count_text <= sources_count* \
		actions /
			<= Meta* $raggu_web_front_pop
				hint <= meta_label @ \How this answer was produced
				bubble_width \17rem
				trigger_content /
					<= Meta_icon* $raggu_web_front_icon_info
				bubble_content /
					<= Meta_body* $mol_view
						sub <= meta_body* /
		body <= sources_body* /
	Meta_title* $raggu_web_front_label
		text <= meta_label
	Meta_rows* $mol_view
		dom_name \dl
		sub <= meta_rows* /
	Meta_row* $mol_view
		sub /
			<= Meta_row_label* $raggu_web_front_label
				dom_name \dt
				text <= meta_row_label* \
			<= Meta_row_value* $mol_view
				dom_name \dd
				sub / <= meta_row_value* \
	Meta_energy* $mol_view
		sub /
			<= Meta_energy_label* $raggu_web_front_label
				dom_name \span
				text <= energy_label @ \energy
			<= Meta_energy_value* $mol_view
				dom_name \span
				sub / <= meta_energy* \
	Meta_plan* $mol_view
		sub /
			<= Meta_plan_label* $raggu_web_front_label
				text <= plan_label @ \sub-questions
			<= Meta_plan_list* $mol_view
				dom_name \ol
				sub <= meta_plan* /
	Plan_item* $mol_view
		dom_name \li
		sub /
			<= Plan_index* $mol_view
				dom_name \span
				sub / <= plan_index* \
			<= plan_text* \
	Source_group* $mol_view
		sub /
			<= Source_group_label* $raggu_web_front_label
				text <= source_group_label* \
			<= Source_group_list* $mol_view
				dom_name \ul
				sub <= source_group_items* /
	Source_entity* $mol_button
		click? <=> source_entity_pick*? null
		sub / <= source_entity_text* \
	Source_relation* $mol_view
		dom_name \li
		sub / <= source_relation_text* \
	Source_chunk* $mol_view
		dom_name \li
		sub /
			<= Source_chunk_text* $raggu_web_front_text
				text <= source_chunk_text* \
	No_sources* $raggu_web_front_text
		text <= no_sources_label @ \The answer came back without a trace.
	entities_label @ \entities
	relations_label @ \relations
	chunks_label @ \chunks
	engine_label @ \engine
	top_k_label @ \top k
	rerank_label @ \rerank
	retrieval_label @ \retrieval
	generation_label @ \generation
	total_label @ \total
	on_label @ \On
	off_label @ \Off
	elapsed_label @ \{n}s elapsed
	failed_label @ \The request failed.

$raggu_web_front_corpus $mol_view
	viewer $raggu_web_front_viewer
	attr *
		^
		raggu_web_front_corpus_chatting <= chat_open false
		raggu_web_front_corpus_graphing <= graph_open true
		raggu_web_front_corpus_hint_only <= hint_only true
	sub /
		<= Spacer $mol_view
		<= Row $mol_view
			sub <= row /
	Graph $mol_view
		sub <= graph_column /
	Controls $raggu_web_front_corpus_controls
		viewer <= viewer
	Stage $mol_view
		sub <= stage_content /
	Failed $mol_view
		sub /
			<= Failed_glass $raggu_web_front_glass
			<= Failed_title $raggu_web_front_text
				text <= failed_title @ \The graph could not be loaded.
			<= Failed_hint $raggu_web_front_text
				text <= failed_hint @ \The API did not answer. It may be waking up — try again in a moment.
			<= Failed_retry $mol_button
				click? <=> retry? null
				sub / <= retry_label @ \Try again
	Cold $raggu_web_front_corpus_loader
		label <= loading_label @ \Laying out the graph
		percent <= percent \
	Warm $raggu_web_front_corpus_loader
		quiet true
		label <= loading_label
	Compact $raggu_web_front_corpus_detail
		viewer <= viewer
		dense true
	Detail $raggu_web_front_corpus_detail
		viewer <= viewer
		hint true
		waiting <= cold false
	Chat $raggu_web_front_corpus_chat
		viewer <= viewer

$raggu_web_front_home_constellation $mol_svg_root
	seed \
	nodes 0
	edges 0
	view_box \0 0 100 100
	aspect \xMidYMid slice
	attr *
		^
		aria-hidden \true
	sub /
		<= Links $mol_svg_path
			geometry <= links \
		<= Points $mol_svg_path
			geometry <= points \
		<= Hubs $mol_svg_path
			geometry <= hubs \

$raggu_web_front_home_card $raggu_web_front_reveal
	dom_name \article
	dataset null
	featured false
	attr *
		^
		raggu_web_front_home_card_featured <= featured
	sub /
		<= Glass $raggu_web_front_glass
		<= Link $raggu_web_front_link
			arg *
				corpus <= id \
			hint <= link_label \
			sub /
				<= Preview $mol_view
					sub /
						<= Constellation $raggu_web_front_home_constellation
							seed <= id
							nodes <= nodes 0
							edges <= edges 0
						<= Shade $mol_view
						<= Domain $raggu_web_front_home_chip
							text <= domain \
				<= Body $mol_view
					sub /
						<= Title $mol_view
							dom_name \h3
							sub / <= title \
						<= Description $raggu_web_front_text
							text <= description \
						<= Stats $mol_view
							dom_name \dl
							sub /
								<= Stat_nodes $raggu_web_front_home_card_stat
									value <= nodes_text \
									label <= entities_label @ \entities
								<= Stat_edges $raggu_web_front_home_card_stat
									value <= edges_text \
									label <= relations_label @ \relations
								<= Stat_communities $raggu_web_front_home_card_stat
									value <= communities_text \
									label <= communities_label @ \communities
								<= Stat_chunks $raggu_web_front_home_card_stat
									value <= chunks_text \
									label <= chunks_label @ \chunks
						<= Types $mol_view
							dom_name \ul
							sub <= types /
						<= Open $mol_view
							dom_name \span
							sub /
								<= open_label @ \Open graph
								<= Open_arrow $raggu_web_front_icon_arrow
	Type* $raggu_web_front_home_chip
		text <= type_name* \
	open_graph_label @ \Open graph

$raggu_web_front_home_card_stat $mol_view
	value \
	label \
	sub /
		<= Value $mol_view
			dom_name \dd
			sub / <= value
		<= Label $raggu_web_front_label
			dom_name \dt
			text <= label

$raggu_web_front_home_chip $raggu_web_front_label
	dom_name \span

$raggu_web_front_app $raggu_web_front_base
	title \RAGU
	Viewer $raggu_web_front_viewer
	attr *
		^
		raggu_web_front_app_corpus <= corpus_page false
	sub /
		<= Skip $raggu_web_front_link
			uri \#main
			sub / <= skip_label @ \Skip to content
		<= Backdrop $mol_view
			attr *
				^
				aria-hidden \true
				raggu_web_front_app_backdrop_quiet <= quiet false
			sub /
				<= Backdrop_base $mol_view
				<= Aurora $mol_view
					sub /
						<= Aurora_a $mol_view
						<= Aurora_b $mol_view
						<= Aurora_c $mol_view
				<= Vignette $mol_view
				<= Grain $mol_view
		<= Scene $raggu_web_front_scene
			viewer <= Viewer
			lights <= theme_resolved \light
		<= Chrome $raggu_web_front_chrome
			viewer <= Viewer
			theme_choice? <=> theme_choice? \system
			theme_resolved <= theme_resolved
			open_settings? <=> open_settings? null
		<= Main $mol_view
			dom_name \main
			attr *
				^
				id \main
			sub <= main /
		<= Settings $raggu_web_front_settings
			showed? <=> settings_open? false
	Home $raggu_web_front_home
	Corpus $raggu_web_front_corpus
		viewer <= Viewer
