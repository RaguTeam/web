$bog_favicon $mol_plugin
	Icon $mol_view

$raggu_web_sidebar_nav $bog_builderui_div
	icon \
	label \
	active false
	click? null
	attr *
		^
		raggu_web_sidebar_nav_active <= active
	event *
		^
		click? <=> click? null
	sub /
		<= Icon $bog_builderui_div sub / <= icon
		<= Label $bog_builderui_div sub / <= label

$raggu_web_sidebar_lang $bog_builderui_div
	label \
	active false
	click? null
	attr *
		^
		raggu_web_sidebar_lang_active <= active
	event *
		^
		click? <=> click? null
	sub / <= label

$raggu_web_sidebar $bog_builderui_div
	screen? \gallery
	dataset_id \wiki
	sections_label_text @ \Sections
	corpus_label_text @ \Active corpus
	corpus_meta_text @ \2,410 nodes · 38 communities
	lang_label_text @ \LANGUAGE
	sub /
		<= Brand $bog_builderui_div sub /
			<= Brand_logo $bog_builderui_div sub / \R
			<= Brand_title $bog_builderui_div sub / \RAGU
			<= Brand_badge $bog_builderui_div sub / \demo
		<= Sections_label $bog_builderui_div sub / <= sections_label_text
		<= Nav $bog_builderui_div sub /
			<= Nav_gallery $raggu_web_sidebar_nav
				icon \▤
				label @ \Datasets
				active <= is_gallery false
				click? <=> click_gallery? null
			<= Nav_explorer $raggu_web_sidebar_nav
				icon \◉
				label @ \Graph
				active <= is_explorer false
				click? <=> click_explorer? null
			<= Nav_chat $raggu_web_sidebar_nav
				icon \💬
				label @ \Chat
				active <= is_chat false
				click? <=> click_chat? null
			<= Nav_dashboard $raggu_web_sidebar_nav
				icon \▦
				label @ \Dashboard
				active <= is_dashboard false
				click? <=> click_dashboard? null
		<= Spacer $bog_builderui_div
		<= Footer $bog_builderui_div sub /
			<= Corpus_label $bog_builderui_div sub / <= corpus_label_text
			<= Corpus_card $bog_builderui_div sub /
				<= Corpus_name $bog_builderui_div sub / <= dataset_name \
				<= Corpus_meta $bog_builderui_div sub / <= corpus_meta_text
			<= Lang_row $bog_builderui_div sub /
				<= Lang_label $bog_builderui_div sub / <= lang_label_text
				<= Lang_en $raggu_web_sidebar_lang
					label \EN
					active <= is_en false
					click? <=> click_en? null
				<= Lang_ru $raggu_web_sidebar_lang
					label \RU
					active <= is_ru false
					click? <=> click_ru? null

$raggu_web_topbar_preset $bog_builderui_div
	label \
	active false
	click? null
	attr *
		^
		raggu_web_topbar_preset_active <= active
	event *
		^
		click? <=> click? null
	sub / <= label

$raggu_web_topbar $bog_builderui_div
	screen \gallery
	dataset_id \wiki
	preset? \demo
	open_settings? null
	preset_label_text @ \Preset
	settings_btn_text @ \⚙ Settings
	export_btn_text @ \↓ Export
	preset_fast_label @ \⚡ Fast
	preset_accurate_label @ \🎯 Accurate
	preset_demo_label @ \🎬 Demo
	sub /
		<= Title_block $bog_builderui_div sub /
			<= Title $bog_builderui_div sub / <= screen_title \
			<= Subtitle $bog_builderui_div sub / <= dataset_name \
		<= Spacer $bog_builderui_div
		<= Preset_label $bog_builderui_div sub / <= preset_label_text
		<= Preset_group $bog_builderui_div sub /
			<= Preset_fast $raggu_web_topbar_preset
				label <= preset_fast_label
				active <= is_fast false
				click? <=> click_fast? null
			<= Preset_accurate $raggu_web_topbar_preset
				label <= preset_accurate_label
				active <= is_accurate false
				click? <=> click_accurate? null
			<= Preset_demo $raggu_web_topbar_preset
				label <= preset_demo_label
				active <= is_demo false
				click? <=> click_demo? null
		<= Settings_btn $bog_builderui_div
			event * click? <=> open_settings? null
			sub / <= settings_btn_text
		<= Export_btn $bog_builderui_div sub / <= export_btn_text

$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$raggu_web_settings_group $bog_builderui_div
	step \
	title \
	opts \
	control \
	reindex true
	reindex_text @ \requires reindexing
	sub /
		<= Head $bog_builderui_div sub /
			<= Step $bog_builderui_div sub / <= step
			<= Reindex $bog_builderui_div
				attr * raggu_web_settings_group_reindex <= reindex
				sub / <= reindex_text
		<= Title $bog_builderui_div sub / <= title
		<= Opts $bog_builderui_div sub / <= opts
		<= Control $bog_builderui_div sub / <= control

$raggu_web_settings $bog_builderui_div
	showed? false
	close? null
	attr *
		^
		raggu_web_settings_showed <= showed?
	sub /
		<= Backdrop $bog_builderui_div
			event * click? <=> close? null
		<= Panel $bog_builderui_div sub /
			<= Header $bog_builderui_div sub /
				<= Header_text $bog_builderui_div sub /
					<= Header_title $bog_builderui_div sub / \Настройки движка RAGU
					<= Header_sub $bog_builderui_div sub / \пресет + ручной режим
				<= Spacer $bog_builderui_div
				<= Close_btn $bog_builderui_div
					event * click? <=> close? null
					sub / \✕
			<= Body $mol_scroll sub /
				<= Group_chunking $raggu_web_settings_group
					step \Шаг 1
					title \Chunking
					opts \Simple / SemanticText / SmartSemantic · размер · overlap
					control \SmartSemanticChunker ▾
					reindex true
				<= Group_extraction $raggu_web_settings_group
					step \Шаг 2
					title \Extraction
					opts \single ↔ two-stage · валидация NEREL · ICL (semantic/BM25/hybrid/random) · модель
					control \two-stage · meno-lite 7B · ICL hybrid ▾
					reindex true
				<= Group_summarization $raggu_web_settings_group
					step \Шаг 3
					title \Summarization
					opts \DBSCAN (eps, min_samples) · LLM-суммаризация сущностей/связей
					control \DBSCAN вкл · суммаризация вкл
					reindex true
				<= Group_communities $raggu_web_settings_group
					step \Шаг 4
					title \Communities
					opts \Hierarchical Leiden (resolution, levels) · суммаризация сообществ
					control \Leiden · resolution 1.0
					reindex true
				<= Group_refinement $raggu_web_settings_group
					step \Шаг 5
					title \Refinement
					opts \RemoveIsolatedNodes и пост-обработчики
					control \RemoveIsolatedNodes вкл
					reindex true
				<= Group_search $raggu_web_settings_group
					step \Шаг 6
					title \Search
					opts \Local/Global/Naive/Mix/QueryPlan · rerank · hybrid (BM25/BM42/SPLADE) · top-k
					control \LocalSearch · rerank ✓ · top-k 8
					reindex false

$raggu_web_gallery_card_preview $bog_builderui_div

$raggu_web_gallery_card $bog_builderui_div
	id \
