$bog_builderui_div $mol_view

$mol_svg $mol_view
	dom_name \svg
	dom_name_space \http://www.w3.org/2000/svg
	font_size 16
	font_family \
	style_size *

$mol_svg_root $mol_svg
	dom_name \svg
	attr *
		^
		viewBox <= view_box \0 0 100 100
		preserveAspectRatio <= aspect \xMidYMid

$mol_svg_path $mol_svg
	dom_name \path
	attr *
		^
		d <= geometry \


$mol_icon $mol_svg_root
	view_box \0 0 24 24
	minimal_width 16
	minimal_height 16
	sub /
		<= Path $mol_svg_path
			geometry <= path \

$mol_icon_graph $mol_icon path \M19.5 17C19.37 17 19.24 17 19.11 17.04L17.5 13.79C17.95 13.34 18.25 12.71 18.25 12C18.25 10.62 17.13 9.5 15.75 9.5C15.62 9.5 15.5 9.5 15.36 9.54L13.73 6.29C14.21 5.84 14.5 5.21 14.5 4.5C14.5 3.12 13.38 2 12 2S9.5 3.12 9.5 4.5C9.5 5.21 9.79 5.84 10.26 6.29L8.64 9.54C8.5 9.5 8.38 9.5 8.25 9.5C6.87 9.5 5.75 10.62 5.75 12C5.75 12.71 6.05 13.34 6.5 13.79L4.89 17.04C4.76 17 4.63 17 4.5 17C3.12 17 2 18.12 2 19.5C2 20.88 3.12 22 4.5 22S7 20.88 7 19.5C7 18.8 6.71 18.16 6.24 17.71L7.86 14.46C8 14.5 8.12 14.5 8.25 14.5C8.38 14.5 8.5 14.5 8.64 14.46L10.27 17.71C9.8 18.16 9.5 18.8 9.5 19.5C9.5 20.88 10.62 22 12 22S14.5 20.88 14.5 19.5C14.5 18.12 13.38 17 12 17C11.87 17 11.74 17 11.61 17.04L10 13.79C10.46 13.34 10.75 12.71 10.75 12S10.46 10.66 10 10.21L11.61 6.96C11.74 7 11.87 7 12 7S12.26 7 12.39 6.96L14 10.21C13.55 10.66 13.25 11.3 13.25 12C13.25 13.38 14.37 14.5 15.75 14.5C15.88 14.5 16 14.5 16.14 14.46L17.77 17.71C17.3 18.16 17 18.8 17 19.5C17 20.88 18.12 22 19.5 22S22 20.88 22 19.5C22 18.12 20.88 17 19.5 17Z

$bog_favicon $mol_plugin
	Icon $mol_view

$bog_theme_auto $mol_plugin
	themes <= themes_default /
	theme_light \$mol_theme_light
	theme_dark \$mol_theme_dark
	mode? \system
	mode_next? null
	theme_next? null
	theme_prev? null
	theme_set? null
	is_light_now false
	attr * mol_theme <= theme \

$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$mol_icon_white_balance_sunny $mol_icon path \M3.55 19.09L4.96 20.5L6.76 18.71L5.34 17.29M12 6C8.69 6 6 8.69 6 12S8.69 18 12 18 18 15.31 18 12C18 8.68 15.31 6 12 6M20 13H23V11H20M17.24 18.71L19.04 20.5L20.45 19.09L18.66 17.29M20.45 5L19.04 3.6L17.24 5.39L18.66 6.81M13 1H11V4H13M6.76 5.39L4.96 3.6L3.55 5L5.34 6.81L6.76 5.39M1 13H4V11H1M13 20H11V23H13

$mol_speck $mol_view
	theme \$mol_theme_accent
	sub /
		<= value null

$mol_button $mol_view
	enabled true
	click? null
	event_click? null
	status? /
	event *
		^
		click? <=> activate? <=> event_activate? null
		dblclick? <=> clicks? null
		keydown? <=> key_press? <=> event_key_press? null
	attr *
		^
		disabled <= disabled false
		role \button
		tabindex <= tab_index 0
		title <= hint_safe <= hint \
	sub /$mol_view_content
		<= title
	Speck $mol_speck
		value <= error \

$mol_button_typed $mol_button
	minimal_height 40
	minimal_width 40

$mol_button_minor $mol_button_typed

$mol_icon_monitor $mol_icon path \M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z

$mol_icon_weather_night $mol_icon path \M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95M17.33,17.97C14.5,17.81 11.7,16.64 9.53,14.5C7.36,12.31 6.2,9.5 6.04,6.68C3.23,9.82 3.34,14.64 6.35,17.66C9.37,20.67 14.19,20.78 17.33,17.97Z

$bog_theme_switch $mol_view
	theme_auto $bog_theme_auto
	sub /
		<= Light $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= light_active false
			hint <= light_hint @ \Светлая
			click?event <=> set_light?event null
			sub /
				<= Light_icon $mol_icon_white_balance_sunny
		<= System $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= system_active false
			hint <= system_hint @ \Как в системе
			click?event <=> set_system?event null
			sub /
				<= System_icon $mol_icon_monitor
		<= Dark $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= dark_active false
			hint <= dark_hint @ \Тёмная
			click?event <=> set_dark?event null
			sub /
				<= Dark_icon $mol_icon_weather_night

$raggu_web_front_sidebar_lang $bog_builderui_div
	label \
	active false
	click? null
	attr *
		^
		raggu_web_front_sidebar_lang_active <= active
	event *
		^
		click? <=> click? null
	sub / <= label

$raggu_web_front_sidebar $bog_builderui_div
	dataset_id \
	dataset_ids /
	select_dataset? null
	Theme_auto $bog_theme_auto
	datasets_label_text @ \Datasets
	lang_label_text @ \LANG
	dataset_name* \
	dataset_meta* \
	sub /
		<= Brand $bog_builderui_div sub /
			<= Brand_logo $bog_builderui_div sub / \R
			<= Brand_title $bog_builderui_div sub / \RAGU
			<= Brand_badge $bog_builderui_div sub / \demo
		<= Datasets_label $bog_builderui_div sub / <= datasets_label_text
		<= Datasets $mol_scroll sub /
			<= Dataset_list $bog_builderui_div sub <= dataset_rows /
				<= Dataset_row* $bog_builderui_div
					attr *
						^
						raggu_web_front_sidebar_dataset_active <= dataset_active* false
					event *
						^
						click? <=> dataset_click*? null
					sub /
						<= Dataset_name* $bog_builderui_div sub / <= dataset_name*
						<= Dataset_meta* $bog_builderui_div sub / <= dataset_meta*
		<= Footer $bog_builderui_div sub /
			<= Lang_row $bog_builderui_div sub /
				<= Theme_switch $bog_theme_switch
					theme_auto <= Theme_auto
				<= Lang_label $bog_builderui_div sub / <= lang_label_text
				<= Lang_en $raggu_web_front_sidebar_lang
					label \EN
					active <= is_en false
					click? <=> click_en? null
				<= Lang_ru $raggu_web_front_sidebar_lang
					label \RU
					active <= is_ru false
					click? <=> click_ru? null

$raggu_web_front_topbar_nav $bog_builderui_div
	icon \
	hint \
	active false
	disabled false
	click? null
	attr *
		^
		title <= hint
		raggu_web_front_topbar_nav_active <= active
		raggu_web_front_topbar_nav_disabled <= disabled
	event *
		^
		click? <=> click? null
	sub /
		<= Icon $bog_builderui_div sub / <= icon

$raggu_web_front_topbar $bog_builderui_div
	screen? \gallery
	dataset_id \wiki
	dataset_title \
	screen_title \
	open_help? null
	toggle_sidebar? null
	help_btn_text @ \? Help
	sub /
		<= Sidebar_btn $raggu_web_front_topbar_nav
			icon \◫
			hint @ \Toggle sidebar
			click? <=> toggle_sidebar? null
		<= Nav $bog_builderui_div sub /
			<= Nav_gallery $raggu_web_front_topbar_nav
				icon \▤
				hint @ \Datasets
				active <= is_gallery false
				click? <=> click_gallery? null
			<= Nav_explorer $raggu_web_front_topbar_nav
				icon \◉
				hint @ \Graph
				active <= is_explorer false
				disabled <= no_dataset false
				click? <=> click_explorer? null
			<= Nav_chat $raggu_web_front_topbar_nav
				icon \💬
				hint @ \Chat
				active <= is_chat false
				disabled <= no_dataset false
				click? <=> click_chat? null
			<= Nav_dashboard $raggu_web_front_topbar_nav
				icon \▦
				hint @ \Dashboard
				active <= is_dashboard false
				disabled <= no_dataset false
				click? <=> click_dashboard? null
			<= Nav_summary $raggu_web_front_topbar_nav
				icon \✦
				hint @ \Summary
				active <= is_summary false
				click? <=> click_summary? null
		<= Help_btn $bog_builderui_div
			event * click? <=> open_help? null
			sub / <= help_btn_text
		<= Spacer_left $bog_builderui_div
		<= Title_block $bog_builderui_div sub /
			<= Title $bog_builderui_div sub / <= screen_title
			<= Subtitle $bog_builderui_div sub / <= dataset_title
		<= Spacer $bog_builderui_div

$raggu_web_front_help_section $bog_builderui_div
	icon \
	title \
	desc \
	media /
	sub /
		<= Icon $bog_builderui_div sub / <= icon
		<= Text $bog_builderui_div sub /
			<= Title $bog_builderui_div sub / <= title
			<= Desc $bog_builderui_div sub / <= desc
			<= Media $bog_builderui_div sub <= media

$raggu_web_front_help $bog_builderui_div
	showed? false
	close? null
	title_text @ \How to use RAGU
	subtitle_text @ \what each section does
	intro_text @ \RAGU builds a knowledge graph from your documents and answers questions over it. The workflow: pick a dataset, explore its graph, ask the agent.
	attr *
		^
		raggu_web_front_help_showed <= showed?
	sub /
		<= Backdrop $bog_builderui_div
			event * click? <=> close? null
		<= Panel $bog_builderui_div sub /
			<= Header $bog_builderui_div sub /
				<= Header_text $bog_builderui_div sub /
					<= Header_title $bog_builderui_div sub / <= title_text
					<= Header_sub $bog_builderui_div sub / <= subtitle_text
				<= Spacer $bog_builderui_div
				<= Close_btn $bog_builderui_div
					event * click? <=> close? null
					sub / \✕
			<= Body $mol_scroll sub /
				<= Intro $bog_builderui_div sub / <= intro_text
				<= Section_gallery $raggu_web_front_help_section
					icon \▤
					title @ \Datasets
					desc @ \Pre-indexed document collections. Pick one to work with, or upload your own documents — RAGU will index them into a knowledge graph.
				<= Section_explorer $raggu_web_front_help_section
					icon \◉
					title @ \Graph
					desc @ \Entities extracted from the documents and relations between them. Drag nodes, zoom with the wheel, click a node or an edge to see its card.
				<= Section_chat $raggu_web_front_help_section
					icon \💬
					title @ \Chat
					desc @ \Ask questions in natural language — the agent answers using the knowledge graph of the active dataset and cites its sources.
				<= Section_dashboard $raggu_web_front_help_section
					icon \▦
					title @ \Dashboard
					desc @ \Indexing pipeline stats: stages and timings, graph size, quality metrics and logs.
				<= Section_summary $raggu_web_front_help_section
					icon \✦
					title @ \Summary
					desc @ \Overview of the RAGU solution: what it consists of and how the pieces fit together.

$raggu_web_front_gallery_card_preview $bog_builderui_div

$raggu_web_front_gallery_card $bog_builderui_div
	id \
	title \
	domain \
	desc \
	nodes \
	edges \
	comms \
	active false
	click? null
	preview_label_text @ \graph preview
	attr *
		^
		raggu_web_front_gallery_card_active <= active
	event *
		^
		click? <=> click? null
	sub /
		<= Preview $raggu_web_front_gallery_card_preview sub /
			<= Preview_label $bog_builderui_div sub / <= preview_label_text
			<= Domain_badge $bog_builderui_div sub / <= domain
		<= Title $bog_builderui_div sub / <= title
		<= Desc $bog_builderui_div sub / <= desc
		<= Tags $bog_builderui_div sub /
			<= Tag_nodes $bog_builderui_div sub / <= tag_nodes \
			<= Tag_edges $bog_builderui_div sub / <= tag_edges \
			<= Tag_comms $bog_builderui_div sub / <= tag_comms \

$raggu_web_front_gallery $bog_builderui_div
	dataset_id \wiki
	select_dataset? null
	datasets /
	header_title_text @ \Corpus gallery
	header_subtitle_text @ \Pick a ready knowledge graph
	mock_badge_text @ \⚠ Mock data — backend is not connected
	dataset_law_title @ \Russian Codes & Laws
	dataset_law_domain @ \Law
	dataset_law_desc @ \Network of norms, references, bodies and concepts of Russian law.
	dataset_wiki_title @ \Wikipedia: Science
	dataset_wiki_domain @ \Encyclopedia
	dataset_wiki_desc @ \Scientists, discoveries, institutions and how they are connected.
	sub /
		<= Header $bog_builderui_div sub /
			<= Header_text $bog_builderui_div sub /
				<= Header_title $bog_builderui_div sub / <= header_title_text
				<= Header_subtitle $bog_builderui_div sub / <= header_subtitle_text
				<= Mock_badge $bog_builderui_div
					attr *
						^
						raggu_web_front_gallery_mock_badge_showed <= is_mock false
					sub / <= mock_badge_text
			<= Spacer $bog_builderui_div
		<= Grid $bog_builderui_div sub <= rows /
			<= Card* $raggu_web_front_gallery_card
				id <= card_id* \
				title <= card_title* \
				domain <= card_domain* \
				desc <= card_desc* \
				nodes <= card_nodes* \
				edges <= card_edges* \
				comms <= card_comms* \
				active <= card_active* false
				click? <=> click*? null

$mol_svg_line $mol_svg
	dom_name \line
	pos /
		<= from /
		<= to /
	attr *
		^
		x1 <= from_x \
		y1 <= from_y \
		x2 <= to_x \
		y2 <= to_y \

$mol_svg_group $mol_svg
	dom_name \g

$mol_svg_text $mol_svg
	dom_name \text
	pos /
	attr *
		^
		x <= pos_x \
		y <= pos_y \
		text-anchor <= align_hor <= align \middle
		alignment-baseline <= align_vert \baseline
	sub /
		<= text \

$mol_svg_circle $mol_svg
	dom_name \circle
	pos /
	attr *
		^
		r <= radius \.5%
		cx <= pos_x \
		cy <= pos_y \

$mol_svg_rect $mol_svg
	dom_name \rect
	pos /
	attr *
		^
		width <= width \0
		height <= height \0
		x <= pos_x \
		y <= pos_y \

$raggu_web_front_explorer_forcegraph $mol_svg_root
	view_box <= computed_view_box \-300 -300 600 600
	aspect \xMidYMid meet
	select?val null
	selected_id? \
	hovered_id? \
	selected_edge_id? \
	hovered_edge_id? \
	drag_id? \
	search \
	filter_type \
	filter_relation \
	filter_comms /
	comm_colors *
	graph_key \
	nodes /
	edges /
	pan_x? +0
	pan_y? +0
	zoom? +1
	positions? *
	gravity +0.03
	force_scale +0.06
	spring +0.2
	damping +0.82
	min_move +0.15
	max_speed +12
	node_size_base +4
	node_size_growth +1.5
	attr *
		^
		data-forcegraph-dim <= dim_active false
	event *
		^
		wheel?event <=> wheel?event null
		pointerdown?event <=> pan_start?event null
		pointermove?event <=> pan_move?event null
		pointerup?event <=> pan_end?event null
		pointercancel?event <=> pan_end?event null
		click?event <=> bg_click?event null
	sub /
		<= G_edges $mol_svg_group
			attr *
				^
				data-forcegraph-base \
			sub <= edge_views /
				<= Edge* $mol_svg_line
					from_x <= edge_x1* \
					from_y <= edge_y1* \
					to_x <= edge_x2* \
					to_y <= edge_y2* \
					attr *
						^
						data-edge-id <= edge_id* \
						stroke <= edge_color* \#7a7672
						stroke-width <= edge_width* \1
						stroke-opacity <= edge_opacity* \0.55
						cursor \pointer
					event *
						^
						click? <=> edge_click*? null
						pointerenter? <=> edge_hover_enter*? null
						pointerleave? <=> edge_hover_leave*? null
		<= G_edge_labels $mol_svg_group
			attr *
				^
				data-forcegraph-base \
			sub <= edge_label_views /
				<= Edge_label* $mol_svg_text
					pos_x <= edge_label_x* \
					pos_y <= edge_label_y* \
					align \middle
					align_vert \middle
					text <= edge_label_text* \
					attr *
						^
						data-edge-id <= edge_id* \
						data-forcegraph-edge-label \
						font-size <= edge_label_font_size \8
						fill-opacity <= edge_label_opacity* \0.75
						cursor \pointer
					event *
						^
						click? <=> edge_click*? null
						pointerenter? <=> edge_hover_enter*? null
						pointerleave? <=> edge_hover_leave*? null
		<= G_nodes $mol_svg_group
			attr *
				^
				data-forcegraph-base \
			sub <= node_views /
				<= Node* $mol_svg_circle
					pos_x <= node_x* \
					pos_y <= node_y* \
					radius <= node_radius* \6
					attr *
						^
						data-node-id <= node_id* \
						fill <= node_color* \#7c6ce0
						fill-opacity <= node_opacity* \1
						cursor \pointer
					event *
						^
						click? <=> click*? null
						pointerenter? <=> hover_enter*? null
						pointerleave? <=> hover_leave*? null
		<= G_node_labels $mol_svg_group
			attr *
				^
				pointer-events \none
				data-forcegraph-base \
			sub <= node_label_views /
				<= Node_label* $mol_svg_text
					pos_x <= node_label_x* \
					pos_y <= node_label_y* \
					align \middle
					text <= node_label_text* \
					attr *
						^
						data-forcegraph-node-label \
						font-size <= node_label_font_size \10
						fill-opacity <= node_label_opacity* \1
		<= G_overlay $mol_svg_group
			attr *
				^
				pointer-events \none
			sub <= overlay_views /
				<= Overlay_edge* $mol_svg_line
					from_x <= edge_x1* \
					from_y <= edge_y1* \
					to_x <= edge_x2* \
					to_y <= edge_y2* \
					attr *
						^
						stroke-width <= overlay_edge_width* \2
						stroke-opacity \0.95
				<= Overlay_node* $mol_svg_circle
					pos_x <= node_x* \
					pos_y <= node_y* \
					radius <= node_radius* \6
					attr *
						^
						fill <= node_color* \#7c6ce0
						stroke-width <= overlay_node_stroke_width* \1.5
				<= Overlay_label* $mol_svg_text
					pos_x <= node_label_x* \
					pos_y <= node_label_y* \
					align \middle
					text <= overlay_label_text* \
					attr *
						^
						data-forcegraph-node-label \
						font-size <= node_label_font_size \10
				<= Overlay_edge_label* $mol_svg_text
					pos_x <= edge_label_x* \
					pos_y <= edge_label_y* \
					align \middle
					align_vert \middle
					text <= overlay_edge_label_text* \
					attr *
						^
						data-forcegraph-edge-label \
						font-size <= edge_label_font_size \8
		<= Tooltip $mol_svg_group
			attr *
				^
				pointer-events \none
			sub <= tooltip_sub /
				<= Tooltip_bg $mol_svg_rect
					pos_x <= tooltip_bg_x \0
					pos_y <= tooltip_bg_y \0
					width <= tooltip_bg_w \0
					height <= tooltip_bg_h \0
					attr *
						^
						rx \3
						ry \3
						stroke-width \1
						data-forcegraph-tooltip-bg \
				<= Tooltip_text $mol_svg_text
					pos_x <= tooltip_x \0
					pos_y <= tooltip_y \0
					align \middle
					align_vert \middle
					text <= tooltip_text \
					attr *
						^
						font-size <= tooltip_font_size \11
						font-weight \600
						data-forcegraph-tooltip-text \

$mol_hotkey $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
