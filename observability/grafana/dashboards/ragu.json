{
  "title": "RAGU — бэкенд",
  "uid": "ragu-back",
  "tags": ["ragu"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Запросов в минуту",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "decimals": 1, "color": { "mode": "thresholds" } }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) * 60",
          "legendFormat": "всего",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Вопросов агенту всего",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "targets": [
        {
          "expr": "sum(http_requests_total{handler=~\".*agent/messages.*\"})",
          "legendFormat": "вопросов",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Доля ошибок 5xx",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ответ агента, p95",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\".*agent/messages.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Запросы по эндпоинтам",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total[5m]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Задержка ответа агента",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 5, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\".*agent/messages.*\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=~\".*agent/messages.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Коды ответов",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "row",
      "title": "По корпусам",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Вопросов по корпусам",
      "description": "За выбранный период. Показывает, какой корпус вообще интересует посетителей.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "legend": { "showLegend": false }, "xTickLabelRotation": -30 },
      "targets": [
        {
          "expr": "sum by (dataset) (increase(ragu_agent_questions_total[$__range]))",
          "legendFormat": "{{dataset}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Язык вопросов",
      "description": "Язык определяется по самому вопросу, а не по переключателю интерфейса.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] } },
      "targets": [
        {
          "expr": "sum by (language) (increase(ragu_agent_questions_total[$__range]))",
          "legendFormat": "{{language}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Движок: что реально отработал",
      "description": "keyword означает, что векторный поиск был недоступен или упал — это деградация, а не режим работы.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] } },
      "targets": [
        {
          "expr": "sum by (engine_used) (increase(ragu_agent_engine_used_total[$__range]))",
          "legendFormat": "{{engine_used}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Сводка по корпусам",
      "description": "Заходы в граф и карточку, вопросы, ответы без найденного контекста и доля запасного ранкера.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": { "decimals": 0, "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Доля keyword" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 0.2 },
                    { "color": "red", "value": 0.5 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "dataset", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true },
            "renameByName": {
              "dataset": "Корпус",
              "Value #A": "Заходы",
              "Value #B": "Вопросы",
              "Value #C": "Без контекста",
              "Value #D": "Доля keyword"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "sum by (dataset) (increase(ragu_dataset_requests_total{kind=~\"graph|detail\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (dataset) (increase(ragu_agent_answers_total[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (dataset) (increase(ragu_agent_empty_retrievals_total[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum by (dataset) (increase(ragu_agent_engine_used_total{engine_used=\"keyword\"}[$__range])) / clamp_min(sum by (dataset) (increase(ragu_agent_engine_used_total[$__range])), 1)",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ретрив против генерации, p95",
      "description": "Где именно уходит время ответа: поиск контекста или вызов LLM.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ragu_agent_retrieval_seconds_bucket[5m])))",
          "legendFormat": "поиск контекста",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ragu_agent_generation_seconds_bucket[5m])))",
          "legendFormat": "генерация LLM",
          "refId": "B"
        }
      ]
    },

    {
      "type": "row",
      "title": "Качество и распределения",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "heatmap",
      "title": "Распределение времени ответа",
      "description": "Каждый столбик — минута, цвет — сколько ответов попало в эту полосу времени. В отличие от перцентилей показывает форму: один долгий хвост или два разных режима.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 41 },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Oranges", "steps": 32 },
        "yAxis": { "unit": "s" },
        "legend": { "show": true },
        "tooltip": { "show": true, "yHistogram": true }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(http_request_duration_seconds_bucket{handler=~\".*agent/messages.*\"}[$__interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Сколько фрагментов попадает в контекст",
      "description": "Среднее число найденных фрагментов на ответ. Падение к нулю означает, что поиск перестал что-либо находить, даже если запросы продолжают отвечать 200.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 41 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto" }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] } },
      "targets": [
        {
          "expr": "sum by (dataset) (rate(ragu_agent_context_chunks_sum[10m])) / clamp_min(sum by (dataset) (rate(ragu_agent_context_chunks_count[10m])), 0.0001)",
          "legendFormat": "{{dataset}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ответов быстрее 10 с",
      "description": "Доля вопросов, на которые агент ответил за десять секунд. Практичнее перцентиля: сразу видно, сколько посетителей у стенда дождались ответа спокойно.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 50 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_request_duration_seconds_bucket{handler=~\".*agent/messages.*\",le=\"10.0\"}[$__range])) / clamp_min(sum(increase(http_request_duration_seconds_count{handler=~\".*agent/messages.*\"}[$__range])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Граф включён или выключен",
      "description": "mix — поиск и по графу, и по чанкам. naive — только чанки. Показывает, пользуются ли посетители переключателем.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 50 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] } },
      "targets": [
        {
          "expr": "sum by (engine) (increase(ragu_agent_questions_total[$__range]))",
          "legendFormat": "{{engine}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Декомпозиция вопроса",
      "description": "Доля вопросов, заданных с включённой галочкой разложения на подвопросы.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 50 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] } },
      "targets": [
        {
          "expr": "sum by (query_plan) (increase(ragu_agent_questions_total[$__range]))",
          "legendFormat": "{{query_plan}}",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
