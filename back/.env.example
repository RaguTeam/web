# Один .env на весь стек, но переменные читают РАЗНЫЕ процессы. Группы ниже —
# по потребителю, а не по теме: положить ключ модели не в ту группу значит
# поднять сервис, который не умеет отвечать.

# ─────────────────────────────────────────────────────────────────────────────
# ragu-api — сервис RAGU поверх готовых графов
# ─────────────────────────────────────────────────────────────────────────────

# Модель. Обязательны все три: в ragu.common.env.Env у них нет значений по
# умолчанию, и без них контейнер падает на валидации при старте.
#
# YandexGPT: модель задаётся полным URI gpt://<folder-id>/<модель>.
#   LLM_MODEL_NAME=gpt://b1g.../yandexgpt-5-pro
#   LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
#   LLM_API_KEY=<ключ Foundation Models>
# Прежние YANDEX_* читал старый бэкенд, который сам ходил в модель. RAGU их
# не знает и молча проигнорирует.
LLM_MODEL_NAME=
LLM_BASE_URL=
LLM_API_KEY=

# Эмбеддер. В docker-compose эти три переопределяются на внутренний сервис;
# здесь они нужны для запуска сервиса вне compose.
EMBEDDER_BASE_URL=http://localhost:8001/v1
EMBEDDER_MODEL_NAME=Alibaba-NLP/gte-multilingual-base
EMBEDDER_API_KEY=unused

# Реранкер. Необязателен: без него сервис отвечает без переупорядочивания и
# говорит об этом в engines.rerank_error, а не падает.
RERANKER_BASE_URL=
RERANKER_MODEL_NAME=
RERANKER_API_KEY=

# Ключ доступа к самому сервису. Пустой список ключей означает, что он отвечает
# всем, кто до него дотянется, а каждый запрос стоит вызовов LLM.
RAGU_API_KEY=

# Бюджеты запроса. По умолчанию их НЕТ ни одного, а API демо открыт наружу без
# аутентификации посетителя — при цене порядка 20 ₽ за вопрос это стоит закрыть.
#
# Важное свойство: бюджет проверяется ПОСЛЕ вызовов, а не до них. Отказ по нему
# означает, что за запрос уже заплачено, а ответа нет. Поэтому бюджет — последняя
# защита, а первая — MIN_CLUSTER_SIZE_FLOOR ниже.
RAGU_API_MAX_TOKENS_PER_REQUEST=60000
RAGU_API_MAX_LLM_CALLS_PER_REQUEST=12
RAGU_API_MAX_CONCURRENT_GENERATIONS=2
RAGU_API_MAX_TOP_K=50

# global делает вызов LLM на КАЖДОЕ сообщество. На корпусе с 480 сообществами
# один такой вопрос — это ~480 вызовов и порядка 400 ₽, причём бюджет отклонит
# его уже после оплаты. Порог отсекает мелкие сообщества: при 180 остаётся
# несколько крупнейших, вопрос стоит единицы рублей и доходит до ответа.
# Подбирать по своему корпусу: GET /v1/graphs/<id>/communities покажет размеры.
RAGU_API_MIN_CLUSTER_SIZE_FLOOR=180

# ─────────────────────────────────────────────────────────────────────────────
# back — бэкенд демо
# ─────────────────────────────────────────────────────────────────────────────
# Про индексы, эмбеддер и модель он ничего не знает: ходит в ragu-api клиентом.

# Адрес внутри docker-сети. Таймаут строго меньше RAGU_API_REQUEST_TIMEOUT
# сервиса (300 с): больше — сервер сдастся первым, и придёт 504.
RAGU_API_URL=http://ragu-api:8020
RAGU_API_TIMEOUT=240

# Размер страницы при сборке подграфа канваса. Не потолок выдачи фронту —
# число вершин намеренно не ограничено, страницами только забираем.
GRAPH_PAGE_SIZE=1000

# Цена за 1000 токенов для витрины стоимости. Токены сервис считает
# токенизатором и помечает estimated: годятся для оценки, не для счёта.
#
# Значения ниже — YandexGPT Pro 5, синхронный режим, с НДС (официальная
# тарификация Yandex AI Studio на сентябрь 2026). Ставь цену СВОЕЙ модели:
# у Pro 5.1 это 0.8, у Lite — 0.2, асинхронный режим почти вдвое дешевле.
TOKEN_PRICE_PROMPT=1.2
TOKEN_PRICE_COMPLETION=1.2

# Подпись к числу стоимости. Валюту цен бэкенд ниоткуда не знает: пусто —
# это «не подписано», а не доллары.
TOKEN_PRICE_CURRENCY=₽

# Формат логов: json в проде (поля остаются полями), text локально.
LOG_FORMAT=text
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Стек
# ─────────────────────────────────────────────────────────────────────────────

# Grafana. Панель публична под /grafana/, поэтому пароль обязателен —
# docker compose откажется стартовать, пока переменная не задана.
GRAFANA_USER=admin
GRAFANA_PASSWORD=
