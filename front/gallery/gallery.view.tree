$raggu_web_front_gallery $bog_builderui_div
	dataset_id \wiki
	select_dataset? null
	datasets /
	header_title_text @ \Corpus gallery
	header_subtitle_text @ \Pick a ready knowledge graph
	mock_badge_text @ \⚠ Mock data — backend is not connected
	dataset_law_title @ \Russian Codes & Laws
	dataset_law_domain @ \Law
	dataset_law_desc @ \Network of norms, references, bodies and concepts of Russian law.
	dataset_wiki_title @ \Wikipedia: Science
	dataset_wiki_domain @ \Encyclopedia
	dataset_wiki_desc @ \Scientists, discoveries, institutions and how they are connected.
	sub /
		<= Header $bog_builderui_div sub /
			<= Header_text $bog_builderui_div sub /
				<= Header_title $bog_builderui_div sub / <= header_title_text
				<= Header_subtitle $bog_builderui_div sub / <= header_subtitle_text
				<= Mock_badge $bog_builderui_div
					attr *
						^
						raggu_web_front_gallery_mock_badge_showed <= is_mock false
					sub / <= mock_badge_text
			<= Spacer $bog_builderui_div
		<= Grid $bog_builderui_div sub <= rows /
			<= Card* $raggu_web_front_gallery_card
				id <= card_id* \
				title <= card_title* \
				domain <= card_domain* \
				desc <= card_desc* \
				nodes <= card_nodes* \
				edges <= card_edges* \
				comms <= card_comms* \
				active <= card_active* false
				click? <=> click*? null
