$raggu_web_front_topbar $bog_builderui_div
	screen? \gallery
	dataset_id \wiki
	dataset_title \
	screen_title \
	open_help? null
	toggle_sidebar? null
	help_btn_text @ \? Help
	sub /
		<= Sidebar_btn $raggu_web_front_topbar_nav
			icon \◫
			hint @ \Toggle sidebar
			click? <=> toggle_sidebar? null
		<= Nav $bog_builderui_div sub /
			<= Nav_gallery $raggu_web_front_topbar_nav
				icon \▤
				hint @ \Datasets
				active <= is_gallery false
				click? <=> click_gallery? null
			<= Nav_explorer $raggu_web_front_topbar_nav
				icon \◉
				hint @ \Graph
				active <= is_explorer false
				disabled <= no_dataset false
				click? <=> click_explorer? null
			<= Nav_chat $raggu_web_front_topbar_nav
				icon \💬
				hint @ \Chat
				active <= is_chat false
				disabled <= no_dataset false
				click? <=> click_chat? null
			<= Nav_summary $raggu_web_front_topbar_nav
				icon \✦
				hint @ \Summary
				active <= is_summary false
				click? <=> click_summary? null
		<= Help_btn $bog_builderui_div
			event * click? <=> open_help? null
			sub / <= help_btn_text
		<= Title_block $bog_builderui_div sub /
			<= Title $bog_builderui_div sub / <= screen_title
			<= Subtitle $bog_builderui_div sub / <= dataset_title
		<= Spacer $bog_builderui_div
