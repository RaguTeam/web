{
    "name"           : "@ugar/ragu-site",
    "type"           : "module",
    "private"        : true,
    "scripts"        : {
        "dev"         : "vite",
        "build"       : "pnpm check && vite build",
        "build:single": "pnpm check && vite build --mode singlefile --outDir dist/single",
        "preview"     : "vite preview",
        "check"       : "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test"        : "tsx --test test/**/*.test.ts"
    },
    "dependencies"   : {
        "@base-ui/react"           : "catalog:",
        "@react-three/drei"        : "catalog:",
        "@react-three/fiber"       : "catalog:",
        "@tanstack/react-query"    : "catalog:",
        "@tanstack/react-router"   : "catalog:",
        "clsx"                     : "catalog:",
        "motion"                   : "catalog:",
        "react"                    : "catalog:",
        "react-dom"                : "catalog:",
        "tailwind-merge"           : "catalog:",
        "three"                    : "catalog:"
    },
    "devDependencies": {
        "@tailwindcss/vite" : "catalog:",
        "@types/node"       : "catalog:",
        "@types/react"      : "catalog:",
        "@types/react-dom"  : "catalog:",
        "@types/three"      : "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "tailwindcss"       : "catalog:",
        "tsx"               : "catalog:",
        "typescript"        : "^5.9.3",
        "vite"              : "catalog:",
        "vite-plugin-singlefile": "catalog:"
    }
}
