$raggu_web_front_sidebar $bog_builderui_div
	dataset_id \
	dataset_ids /
	select_dataset? null
	Theme_auto $bog_theme_auto
	datasets_label_text @ \Datasets
	lang_label_text @ \LANG
	dataset_name* \
	dataset_meta* \
	sub /
		<= Brand $bog_builderui_div sub /
			<= Brand_logo $mol_image
				uri \raggu/web/front/assets/logo.jpg
				title \RAGU
			<= Brand_title $bog_builderui_div sub / \RAGU
			<= Brand_badge $bog_builderui_div sub / \demo
		<= Datasets_label $bog_builderui_div sub / <= datasets_label_text
		<= Datasets $mol_scroll sub /
			<= Dataset_list $bog_builderui_div sub <= dataset_rows /
				<= Dataset_row* $bog_builderui_div
					attr *
						^
						raggu_web_front_sidebar_dataset_active <= dataset_active* false
					event *
						^
						click? <=> dataset_click*? null
					sub /
						<= Dataset_name* $bog_builderui_div sub / <= dataset_name*
						<= Dataset_meta* $bog_builderui_div sub / <= dataset_meta*
		<= Footer $bog_builderui_div sub /
			<= Lang_row $bog_builderui_div sub /
				<= Theme_switch $bog_theme_switch
					theme_auto <= Theme_auto
				<= Lang_label $bog_builderui_div sub / <= lang_label_text
				<= Lang_en $raggu_web_front_sidebar_lang
					label \EN
					active <= is_en false
					click? <=> click_en? null
				<= Lang_ru $raggu_web_front_sidebar_lang
					label \RU
					active <= is_ru false
					click? <=> click_ru? null
