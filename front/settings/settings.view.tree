$raggu_web_front_settings $bog_builderui_div
	showed? false
	close? null
	attr *
		^
		raggu_web_front_settings_showed <= showed?
	sub /
		<= Backdrop $bog_builderui_div
			event * click? <=> close? null
		<= Panel $bog_builderui_div sub /
			<= Header $bog_builderui_div sub /
				<= Header_text $bog_builderui_div sub /
					<= Header_title $bog_builderui_div sub / <= header_title_text @ \Settings
					<= Header_sub $bog_builderui_div sub / <= header_sub_text @ \how the agent searches
				<= Spacer $bog_builderui_div
				<= Close_btn $bog_builderui_div
					event * click? <=> close? null
					sub / \✕
			<= Body $mol_scroll sub /
				<= Group_retrieval $raggu_web_front_settings_group
					step \Поиск
					title \Retrieval
					opts @ \graph in answering · decomposition of complex questions
					reindex false
					controls /
						<= Use_graph_row $bog_builderui_div sub /
							<= Use_graph_label $bog_builderui_div sub / <= use_graph_label_text @ \Graph in search
							<= Use_graph_help $bog_builderui_div
								attr * title <= use_graph_hint_text @ \Enable/disable use of the graph when answering.
								sub / \?
							<= Use_graph $bog_builderui_select
								value? <=> use_graph? \on
								dictionary *
									on @ \On
									off @ \Off
						<= Query_plan_row $bog_builderui_div sub /
							<= Query_plan_label $bog_builderui_div sub / <= query_plan_label_text @ \QueryPlanEngine in search
							<= Query_plan_help $bog_builderui_div
								attr * title <= query_plan_hint_text @ \Enable/disable decomposition of complex questions.
								sub / \?
							<= Query_plan $bog_builderui_select
								value? <=> query_plan? \off
								dictionary *
									on @ \On
									off @ \Off
