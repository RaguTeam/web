$raggu_web_front_app $bog_builderui_div
	screen? \gallery
	dataset_id? \
	help_open? false
	sidebar_collapsed? false
	body /
	lights_mode \light
	screen_gallery_title @ \Datasets
	screen_explorer_title @ \Knowledge graph
	screen_summary_title @ \Solution overview
	ask_entity_template @ \Tell me about the entity «%s» from the knowledge graph.
	ask_relation_template @ \Tell me about the relation «%s» from the knowledge graph.
	attr *
		^
		bog_builderui_lights <= lights_mode
		bog_builderui_base \stone
		bog_builderui_theme \violet
		bog_builderui_chart \purple
		bog_builderui_radius \medium
		bog_builderui_font_body \inter
		bog_builderui_font_head \inter
	plugins /
		<= Favicon $bog_favicon
			Icon <= favicon_icon $mol_icon_graph
		<= Theme_auto $bog_theme_auto
	sub /
		<= Sidebar $raggu_web_front_sidebar
			attr *
				^
				raggu_web_front_sidebar_hidden <= sidebar_hidden false
			dataset_id <= dataset_id
			dataset_ids <= dataset_ids /
			dataset_name* <= sidebar_dataset_name* \
			dataset_meta* <= sidebar_dataset_meta* \
			select_dataset? <=> select_dataset? null
			Theme_auto <= Theme_auto
		<= Main $bog_builderui_div sub /
			<= Topbar $raggu_web_front_topbar
				screen? <=> screen?
				dataset_id <= dataset_id
				dataset_title <= dataset_title \
				screen_title <= screen_title \
				open_help? <=> open_help? null
				toggle_sidebar? <=> toggle_sidebar? null
			<= Body $mol_scroll sub <= body
		<= Help $raggu_web_front_help
			showed? <=> help_open?
		<= Summary_popup $mol_view
	Gallery $raggu_web_front_gallery
		dataset_id <= dataset_id
		select_dataset? <=> select_dataset? null
	Explorer $raggu_web_front_explorer
		dataset_id <= dataset_id
	Summary $raggu_web_front_summary
